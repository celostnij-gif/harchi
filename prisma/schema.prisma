generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(cuid())
  publicId  String   @unique @default(cuid())
  name      String
  phone     String
  delivery  String
  city      String?
  address   String?
  comment   String?
  items     String
  total     Float
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Category {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  nameUk   String
  nameEn   String
  sort     Int    @default(0)
  isActive Boolean @default(true)
}

model Product {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  nameUk        String
  nameEn        String   @default("")
  shortUk       String   @default("")
  shortEn       String   @default("")
  descriptionUk String   @default("")
  descriptionEn String   @default("")
  portionUk     String   @default("")
  portionEn     String   @default("")
  cats          String   @default("")
  price         Float
  oldPrice      Float?
  image         String
  badge         String?
  rating        Float    @default(4.9)
  reviewsCount  Int      @default(0)
  kcal          Int?
  weight        Int?
  specs         String   @default("[]")
  productFaq    String   @default("[]")
  /** Оптові скидки: JSON-рядок [{minQty, price}] — ціна за шт. від кількості. */
  bulkTiers     String   @default("[]")
  isActive      Boolean  @default(true)
  sort          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id          Int      @id @default(autoincrement())
  author      String
  roleUk      String   @default("")
  roleEn      String   @default("")
  textUk      String
  textEn      String   @default("")
  rating      Int      @default(5)
  productSlug String?
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
}

model FaqItem {
  id        Int      @id @default(autoincrement())
  qUk       String
  qEn       String   @default("")
  aUk       String
  aEn       String   @default("")
  isActive  Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model SectionContent {
  key       String   @id
  data      String   @default("{}")
  visible   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt
}

/// Сторінки та пости, перенесені зі старого сайту harchifood.com.
/// Джерело: temp/site (бекап WP: /wp-json/wp/v2/pages, /posts).
/// legacyUrl — старий абсолютний URL (для карт 301/rewrite при переїзді).
model ContentPage {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  kind        String    @default("page") // "page" | "post"
  legacyUrl   String    @default("")
  titleUk     String
  titleEn     String    @default("")
  excerptUk   String    @default("")
  excerptEn   String    @default("")
  /// HTML-тіло (очищене від WP-сміття, посилання на /uploads/...)
  bodyUk      String    @default("")
  bodyEn      String    @default("")
  coverImage  String    @default("")
  publishedAt DateTime?
  isActive    Boolean   @default(true)
  sort        Int       @default(0)
  seoTitleUk  String    @default("")
  seoDescUk   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kind, isActive, sort])
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  filename  String   @unique
  url       String
  size      Int      @default(0)
  createdAt DateTime @default(now())
}
